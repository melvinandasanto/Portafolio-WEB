<section id="inicio" class="hero">
  <div class="container hero-content">
    <div class="profile-card">
      <img src="{{profile_image}}" alt="Foto de perfil de {{name}}" />
    </div>
    <div class="hero-text">
      <p class="eyebrow">{{role}}</p>
      <h1>{{intro}}</h1>
      <p class="bio">{{bio}}</p>
    </div>
  </div>
</section>
